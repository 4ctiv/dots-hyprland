#!/bin/bash

LAYOUT=$(hyprctl -j getoption general:layout | jq '.str' | sed 's/"//g')

case $LAYOUT in
"master")
  #hyprctl keyword general:layout dwindle
  hyprctl dispatch 'hl.workspace_rule({ workspace = "name:" .. tostring(hl.get_active_workspace().name), layout = "dwindle" })'
  #hyprctl keyword unbind SUPER,O
  #hyprctl keyword bind SUPER,J,layoutmsg,cyclenext
  notify-send "Dwindle Layout"
  ;;
"dwindle")
  #hyprctl keyword general:layout master
  hyprctl dispatch 'hl.workspace_rule({ workspace = "name:" .. tostring(hl.get_active_workspace().name), layout = "master" })'
  #hyprctl keyword unbind SUPER,O
  #hyprctl keyword bind SUPER,J,layoutmsg,cyclenext
  notify-send "Master Layout"
  ;;
*) ;;

esac
