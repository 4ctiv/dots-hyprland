[Desktop Entry]
Categories=Utility;X-SuSE-SyncUtility;
Type=Application
Exec=syncin-desktop %u
Name=Syncin Desktop
Comment=Syncin desktop client
GenericName=Folder Sync
Icon=cloudstatus-symbolic
Keywords=Syncin;sync-in;Cloud;syncing;file;sharing;
X-GNOME-Autostart-Delay=3
#MimeType=application/vnd.nextcloud;x-scheme-handler/nc;
SingleMainWindow=true
Actions=Quit;

# Translations
Comment[de]=Syncin Desktop-Synchronisationsclient
GenericName[de]=Ordner-Synchronisation
Name[de]=Syncin Desktop-Synchronisationsclient
Icon[de]=Syncin
Comment[ja_JP]=Syncin デスクトップ同期クライアント
GenericName[ja_JP]=フォルダー同期
Name[ja_JP]=Syncin デスクトップ同期クライアント
Icon[ja_JP]=Syncin
Comment[en_GB]=Syncin desktop synchronisation client
GenericName[en_GB]=Folder Sync
Name[en_GB]=Syncin desktop sync client 
Icon[en_GB]=Syncin
Comment[de_DE]=Syncin Desktop-Synchronisationsclient
GenericName[de_DE]=Ordner-Synchronisation
Name[de_DE]=Syncin Desktop-Synchronisationsclient
Icon[de_DE]=Syncin
Implements=org.freedesktop.CloudProviders

